# Origin of the framework's Flask server (webserver.open_dashboard, default port 8765).
# Leave the value empty to use the Vite dev proxy instead (same-origin /api/results).
VITE_API_URL=http://127.0.0.1:8765

# Seconds between polls of /api/results. 0 disables polling.
VITE_POLL_SECONDS=20

# Tab shown first: overview | instruments
VITE_START_TAB=overview

# Default window for every chart: 3M | 1Y | 5Y | ALL
VITE_DEFAULT_WINDOW=1Y

# Estimated round-turn fee per contract, in dollars. The framework does not
# publish fees; the terminal derives them from realised turnover.
VITE_FEE_PER_CONTRACT=2.25
